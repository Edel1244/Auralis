<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers on a home network often run plain HTTP (e.g. http://192.168.1.20:3000),
     so cleartext is allowed; public servers should use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
