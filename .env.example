# ─── AURALIS configuration ───────────────────────────────────────────
# Copy to `.env` and adjust. Never commit real secrets.

# Public URL of the app (used in emails and share links)
APP_URL=http://localhost:3000

# PostgreSQL connection string.
# Local zero-install dev (`npm run db:start` runs embedded Postgres/PGlite on 5433).
# PGlite is a single Postgres session shared by all connections, so `pgbouncer=true`
# is required (it stops Prisma from using named prepared statements). Not needed for real PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=5&pgbouncer=true
# With Docker Compose, DATABASE_URL is built automatically from POSTGRES_PASSWORD (see docker-compose.yml).

# ─── Docker Compose only ───
# Password for the bundled PostgreSQL container (required for `docker compose up`).
POSTGRES_PASSWORD=change-me-db-password
# Host port the app is published on.
AURALIS_PORT=3000

# Long random string (>= 32 chars). Signs short-lived media URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ─── Object storage ───
# "local" stores files on disk under STORAGE_LOCAL_DIR; "s3" uses any S3-compatible service (MinIO, R2, AWS, Garage...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=auralis
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Email ───
# SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587
# If empty, emails are written to .data/mail/*.eml and logged to the console (development).
SMTP_URL=
MAIL_FROM="AURALIS <no-reply@auralis.local>"

# ─── Limits ───
MAX_UPLOAD_MB=200
DEFAULT_STORAGE_QUOTA_MB=2048
# Require verified email before uploading (recommended in production)
REQUIRE_VERIFIED_EMAIL_FOR_UPLOAD=false
